{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netflix-gpt",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Serve the React app for client-side routes like /browse.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
  // TMDB_TOKEN is a secret: `wrangler secret put TMDB_TOKEN` (or .dev.vars locally).
}
